# Copy this file to `.env.local` and paste your TypeSafe API key after the `=`.
#
#   cp .env.local.example .env.local
#
# Get a key at https://typesafe.ai. Leave it empty (or skip .env.local entirely)
# to run in demo mode: routing decisions are simulated with keyword matching and
# the UI is clearly labeled "Demo mode — simulated, not real Jev calls."
#
# The key is only ever read on the server (app/api/route/route.ts). It is never
# sent to the browser. Do NOT prefix it with NEXT_PUBLIC_.
TYPESAFE_API_KEY=

# Optional: override the Jev model id (defaults to jev-latest).
# JEV_MODEL=jev-latest
