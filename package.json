{
  "name": "typesafe-router",
  "version": "0.1.0",
  "private": true,
  "description": "Jev Tool & Model Router \u2014 Jev decides, your code executes.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:op": "op run --env-file=.env.1password -- next dev",
    "start:op": "op run --env-file=.env.1password -- next start"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
